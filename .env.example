# Copy to .env and/or use Settings → Connections setup (writes data/app_config.json)

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Optional — session signing (defaults to ENCRYPTION_KEY or a dev fallback)
# JWT_SECRET=

# Plaid (https://dashboard.plaid.com/developers/keys) — bring your own
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_ENABLED=false
# PLAID_REDIRECT_URI=http://127.0.0.1:8000/oauth/plaid.html
# Production OAuth banks often need https://127.0.0.1:8000/oauth/plaid.html + make trust-cert

PLAID_TRANSACTIONS_SYNC_DAYS=7
PLAID_HOLDINGS_SYNC_DAYS=30

# Google Drive backups — Web OAuth client (bring your own)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=https://localhost:8000/oauth/google-drive.html

API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,https://127.0.0.1:8000,https://localhost:8000

CLOUD_SCHEDULER_ENABLED=false
